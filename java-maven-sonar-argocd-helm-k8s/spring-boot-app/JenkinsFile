pipeline {
    agent any

    tools {
        maven 'mvn'
    }
    environment {
        APP_PATH = "java-maven-sonar-argocd-helm-k8s/spring-boot-app"
        REGISTRY = "gangalakunta"
        PROJECT_ID = 'project-820f02b7-4f02-4540-a71'
        CLUSTER_NAME = 'my-cluster'
        REGION = 'us-central1'
    }
    stages {
        stage('Clean Workspace') {
            steps {
                deleteDir()
            }
        }
        stage('Checkout') {
            steps {
                git branch: 'master',
                    credentialsId: 'git',
                    url: 'git@github.com:anilkumarreddy10/Jenkins-Zero-To-Hero.git'
            }
        }

        stage('Build') {
            steps {
                configFileProvider([
                    configFile(fileId: 'maven-settings', variable: 'SETTINGS')]) {
                    script {
                        if (params.PERFORM_MAVEN_RELEASE) {
                           sh """ cd ${APP_PATH} &&
                           mvn -B release:clean release:prepare release:perform \
                           -Dmaven.test.failure.ignore=true \
                           -s ${SETTINGS}
                           """
                        }
                        else{
                          sh 'cd ${APP_PATH} && mvn clean deploy -s ${SETTINGS}'
                        }
                    }
                }
            }
        }
        stage('sonarqube') {
            steps {
                configFileProvider([configFile(fileId: 'maven-settings', variable: 'SETTINGS')]){
                    withSonarQubeEnv('sonarqube') {
                        sh """cd ${APP_PATH} && mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar -s ${SETTINGS}"""
                    }
                }
            }
        }
        stage('docker-build') {
            steps {
                script {
                     def pom = readMavenPom file: 'java-maven-sonar-argocd-helm-k8s/spring-boot-app/pom.xml'
                      env.IMAGE_NAME = pom.artifactId
                      env.IMAGE_TAG  = pom.version
                      def image = docker.build("${REGISTRY}/${IMAGE_NAME}:${IMAGE_TAG}","${APP_PATH}")
                }
            }
        }
        stage('push image') {
            steps {
                script {
                   docker.withRegistry('https://index.docker.io/v1/','docker-cred')
                   image.push()
                }
            }
        }
        stage('deploy to gke') {
            steps {
                withCredentials([
                     file(
                         credentialsId: 'gke-kubeconfig',
                         variable: 'KUBECONFIG'
                     )
                ]) {
                    sh "kubectl apply -f java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/ "
             }
        }
    }
}
}
